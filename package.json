{
  "name": "egret-r",
  "version": "6.0.0",
  "private": true,
  "description": "Egret Engine R - Modern HTML5 Game Engine",
  "scripts": {
    "build": "npm run build -w packages",
    "build:core": "npm run build -w @egret-r/core",
    "build:eui": "npm run build -w @egret-r/eui",
    "build:game": "npm run build -w @egret-r/game",
    "build:tween": "npm run build -w @egret-r/tween",
    "build:socket": "npm run build -w @egret-r/socket",
    "clean": "npm run clean -w packages --if-present",
    "lint": "tsc -b"
  },
  "engines": {
    "node": ">=18"
  },
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "typescript": "^5.4.0"
  }
}