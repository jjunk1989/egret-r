{
  "name": "egret-r",
  "version": "6.0.0",
  "private": true,
  "description": "Egret Engine R - Modern HTML5 Game Engine",
  "scripts": {
    "build": "node scripts/build-esm-direct.js",
    "build:v3": "node scripts/build-esm-v3.js",
    "build:core": "node scripts/build-esm-direct.js",
    "clean": "node scripts/clean-dist.js",
    "check:bare": "node scripts/check-bare-symbols.js",
    "check:bundle": "node scripts/verify-bundle.js",
    "verify": "node scripts/verify-dist.js",
    "watch": "node scripts/build-esm-direct.js --watch",
    "watch:core": "node scripts/build-esm-direct.js --watch",
    "dev": "node scripts/build-esm-direct.js && npm -w examples/basic run dev",
    "lint": "eslint src/ examples/",
    "lint:fix": "eslint src/ examples/ --fix",
    "format": "prettier --write \"src/**/*.ts\" \"examples/**/*.ts\""
  },
  "engines": {
    "node": ">=18"
  },
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "chokidar": "^5.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.4",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.62.0"
  }
}
