{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "target": "ES2020",
        "lib": ["ES2020", "DOM", "ScriptHost"],
        "outDir": "../../packages/core/dist",
        "rootDir": "..",
        "noImplicitAny": false,
        "strictNullChecks": false,
        "strictPropertyInitialization": false
    },
    "include": [
        "../Defines.debug.ts",
        "../Defines.release.ts",
        "./**/*.ts"
    ],
    "exclude": [
        "**/native/**",
        "**/node_modules/**"
    ]
}